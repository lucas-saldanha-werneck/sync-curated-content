# sync-raindrop — variáveis de ambiente. NUNCA commitar valores reais.
# Na VPS: /opt/sync-raindrop/.env (chmod 600, root:root), montado read-only em /secrets/.env

# Raindrop.io — app.raindrop.io > Settings > Integrations > For Developers > Test token
RAINDROP_TOKEN=

# Dropbox — quando o storage usa rclone.conf (RCLONE_CONF, já fixo no Dockerfile),
# estes 3 ficam como placeholders "via-rclone" só para satisfazer load_config();
# o token real vem do refresh feito pelo rclone, não destas chaves.
DROPBOX_REFRESH_TOKEN=via-rclone
DROPBOX_APP_KEY=via-rclone
DROPBOX_APP_SECRET=via-rclone

# Groq — console.groq.com/keys (transcrição de áudio/vídeo)
GROQ_API_KEY=

# Claude Code — token OAuth de assinatura (claude setup-token)
CLAUDE_CODE_OAUTH_TOKEN=

# Opcionais — capacidades extras de fetch (em branco = desativado)
APIFY_TOKEN=
JINA_API_KEY=
FIRECRAWL_API_KEY=

# UptimeRobot — URL de heartbeat (push monitor), se usado. O monitor principal é
# por keyword em https://files.2olhares.com/sync-raindrop/health.json (ver host/health-stale.sh).
UPTIMEROBOT_URL=

# Config geral
TZ=America/Sao_Paulo
CLAUDE_MODEL=claude-fable-5-1
VAULT_ROOT=/Projects/vault
